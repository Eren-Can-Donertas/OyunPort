# OyunPort Docker Compose ortam değişkenleri.
# Kopyalayın:  cp .env.example .env   (yalnızca geliştirme/demo değerleridir)

# PostgreSQL süper kullanıcısı (yalnızca ilk önyükleme için)
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_pw
# Şema sahibi / migration kullanıcısı
DB_ADMIN_PASSWORD=db_admin_dev_pw
# Uygulama veritabanı rolleri (Flyway V5 bu parolalarla oluşturur)
APP_CUSTOMER_DB_PASSWORD=app_customer_dev_pw
APP_ADMIN_DB_PASSWORD=app_admin_dev_pw
REPORTING_DB_PASSWORD=reporting_dev_pw
DATA_LOADER_DB_PASSWORD=data_loader_dev_pw

# JWT imzalama anahtarı (en az 32 bayt)
JWT_SECRET=oyunport-dev-jwt-secret-change-me-0123456789

# Ana makinede yayınlanan portlar
DB_HOST_PORT=55433
BACKEND_HOST_PORT=8081
WEB_HOST_PORT=8080
